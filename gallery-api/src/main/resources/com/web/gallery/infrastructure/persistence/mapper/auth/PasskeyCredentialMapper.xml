<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">


<mapper namespace="com.web.gallery.infrastructure.persistence.mapper.auth.PasskeyCredentialMapper">

	<resultMap id="PasskeyCredentialMap" type="com.web.gallery.infrastructure.persistence.entity.auth.PasskeyCredential">
		<result property="passkeyNo" column="passkey_no"/>
		<result property="accountNo" column="account_no"/>
		<result property="credentialId" column="credential_id"/>
		<result property="attestedCredentialData" column="attested_credential_data"/>
		<result property="signCount" column="sign_count"/>
		<result property="transports" column="transports"/>
		<result property="isBackupEligible" column="is_backup_eligible"/>
		<result property="isBackedUp" column="is_backed_up"/>
		<result property="isUvInitialized" column="is_uv_initialized"/>
		<result property="passkeyName" column="passkey_name"/>
		<result property="lastUsedAt" column="last_used_at"/>
		<result property="createdBy" column="created_by"/>
		<result property="createdAt" column="created_at"/>
		<result property="updatedBy" column="updated_by"/>
		<result property="updatedAt" column="updated_at"/>
	</resultMap>

	<sql id="columns">
		passkey_no,
		account_no,
		credential_id,
		attested_credential_data,
		sign_count,
		transports,
		is_backup_eligible,
		is_backed_up,
		is_uv_initialized,
		passkey_name,
		last_used_at,
		created_by,
		created_at,
		updated_by,
		updated_at
	</sql>

	<sql id="where">
		<where>
			<!-- 条件が1つも指定されていない場合に全件を対象にしてしまうのを防ぐガード。
			     抽出条件はファクトリメソッド経由での生成を前提としているが、builder()から直接組み立てられた
			     場合でも1件も対象にしないようにする -->
			<if test="accountNo == null and passkeyNo == null and credentialId == null"> AND 1 = 0</if>
			<if test="accountNo != null"> AND account_no = #{accountNo}</if>
			<if test="passkeyNo != null"> AND passkey_no = #{passkeyNo}</if>
			<if test="credentialId != null"> AND credential_id = #{credentialId}</if>
		</where>
	</sql>

	<insert id="insert" parameterType="com.web.gallery.infrastructure.persistence.entity.auth.PasskeyCredential">
		INSERT INTO common.passkey_credential (
			account_no,
			credential_id,
			attested_credential_data,
			sign_count,
			transports,
			is_backup_eligible,
			is_backed_up,
			is_uv_initialized,
			passkey_name,
			last_used_at,
			created_by,
			created_at,
			updated_by,
			updated_at
		) VALUES (
			#{accountNo},
			#{credentialId},
			#{attestedCredentialData},
			#{signCount},
			COALESCE(#{transports}, ''),
			#{isBackupEligible},
			#{isBackedUp},
			#{isUvInitialized},
			#{passkeyName},
			COALESCE(#{lastUsedAt}, NOW()),
			#{createdBy},
			COALESCE(#{createdAt}, NOW()),
			#{updatedBy},
			COALESCE(#{updatedAt}, NOW())
		)
	</insert>

	<select id="select" parameterType="com.web.gallery.infrastructure.persistence.entity.auth.PasskeyCredentialCondition" resultMap="PasskeyCredentialMap">
		SELECT
			<include refid="columns"/>
		FROM
			common.passkey_credential
		<include refid="where"/>
		ORDER BY
			created_at ASC,
			passkey_no ASC
	</select>

	<select id="selectForUpdate" parameterType="com.web.gallery.infrastructure.persistence.entity.auth.PasskeyCredentialCondition" resultMap="PasskeyCredentialMap">
		SELECT
			<include refid="columns"/>
		FROM
			common.passkey_credential
		<include refid="where"/>
		FOR UPDATE
	</select>

	<select id="count" parameterType="com.web.gallery.infrastructure.persistence.entity.auth.PasskeyCredentialCondition" resultType="Integer">
		SELECT
			COUNT(*)
		FROM
			common.passkey_credential
		<include refid="where"/>
	</select>

	<update id="update">
		UPDATE common.passkey_credential
		<set>
			<if test="target.signCount != null"> sign_count = #{target.signCount},</if>
			<if test="target.isBackedUp != null"> is_backed_up = #{target.isBackedUp},</if>
			<if test="target.lastUsedAt != null"> last_used_at = #{target.lastUsedAt},</if>
			<if test="target.passkeyName != null"> passkey_name = #{target.passkeyName},</if>
			updated_by = #{target.updatedBy},
			updated_at = NOW()
		</set>
		<where>
			<if test="condition.accountNo == null and condition.passkeyNo == null and condition.credentialId == null"> AND 1 = 0</if>
			<if test="condition.accountNo != null"> AND account_no = #{condition.accountNo}</if>
			<if test="condition.passkeyNo != null"> AND passkey_no = #{condition.passkeyNo}</if>
			<if test="condition.credentialId != null"> AND credential_id = #{condition.credentialId}</if>
		</where>
	</update>

	<delete id="delete" parameterType="com.web.gallery.infrastructure.persistence.entity.auth.PasskeyCredentialCondition">
		DELETE FROM
			common.passkey_credential
		<include refid="where"/>
	</delete>

</mapper>
