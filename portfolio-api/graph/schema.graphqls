"""
公開ページ向けのポートフォリオ表示API

公開状態（published）のポートフォリオだけを返す。下書き・削除済みのポートフォリオと、
削除済み・管理者により非公開にされた写真は返さない。認証は不要（Next.js のサーバーからのみ呼び出す前提）。
"""
type Query {
  """
  アカウントの公開中のポートフォリオ一覧（表示順）。アカウントが存在しない場合は空の一覧を返す

  keyword を指定した場合は、テーマ・タグ名（日本語・英語）のいずれかに部分一致するもの（大文字・小文字を区別しない）に絞り込む。
  前後の空白は除き、空の場合は絞り込まない。100文字を超える場合は空の一覧を返す

  表示順で offset 件目から最大 limit 件を返す。limit は 1〜1000、offset は 0〜200000 で、範囲外の場合は空の一覧を返す
  """
  publishedPortfolios(accountId: ID!, keyword: String, limit: Int = 20, offset: Int = 0): PortfolioSummaryPage!

  "公開中のポートフォリオ。存在しない・公開されていない場合は null を返す"
  publishedPortfolio(accountId: ID!, portfolioNo: Int!): Portfolio
}

"日時（RFC 3339）"
scalar DateTime

"ポートフォリオのテンプレート"
enum PortfolioTemplate {
  "フィーチャー型（写真ごとにテーマ・サブテーマ・説明を持つセクションを縦に並べる）"
  FEATURE
  "グリッド型（1行に2〜3枚の写真を組み合わせて並べる）"
  GRID
  "額縁型（1枚の額縁に複数の写真・メッセージを自由に配置した組写真）"
  FRAME
}

"写真の向き"
enum PhotoDirection {
  VERTICAL
  HORIZONTAL
  SQUARE
  NONE
}

"写真"
type Photo {
  "写真番号"
  photoNo: Int!
  "画像の署名付きURL（有効期限あり）"
  url: String!
  "写真タイトル（日本語）"
  japaneseTitle: String!
  "写真タイトル（英語。未設定の場合は空文字）"
  englishTitle: String!
  "写真の向き"
  direction: PhotoDirection!
}

"タグ"
type Tag {
  japaneseName: String!
  "未設定の場合は空文字"
  englishName: String!
}

"公開中のポートフォリオ一覧の1ページ分"
type PortfolioSummaryPage {
  "表示順のポートフォリオ"
  portfolios: [PortfolioSummary!]!
  "このページより後ろに続きのポートフォリオがあるかどうか"
  hasNext: Boolean!
}

"ポートフォリオ一覧の1件分"
type PortfolioSummary {
  portfolioNo: Int!
  theme: String!
  description: String!
  template: PortfolioTemplate!
  tags: [Tag!]!
  "表示順の先頭の写真（写真が1枚もない場合は null）"
  coverPhoto: Photo
  photoCount: Int!
  updatedAt: DateTime!
}

"ポートフォリオ"
type Portfolio {
  portfolioNo: Int!
  theme: String!
  description: String!
  template: PortfolioTemplate!
  tags: [Tag!]!
  updatedAt: DateTime!
  "テンプレートごとのレイアウト。`__typename` でテンプレートを判別する"
  layout: PortfolioLayout!
}

"""
テンプレートごとのレイアウト

テンプレートを追加する場合は、レイアウトの型を追加してこの union に加える
"""
union PortfolioLayout = FeatureLayout | GridLayout | FrameLayout

"フィーチャー型のレイアウト"
type FeatureLayout {
  "表示順のセクション"
  sections: [FeatureSection!]!
}

"フィーチャー型のセクション（写真1枚分）"
type FeatureSection {
  photo: Photo!
  theme: String!
  "未設定の場合は空文字"
  subTheme: String!
  "未設定の場合は空文字"
  description: String!
}

"グリッド型のレイアウト"
type GridLayout {
  "上から順の行"
  rows: [GridRow!]!
}

"グリッド型の行パターン"
enum GridRowPattern {
  "2枚を均等幅で並べる"
  TWO_EQUAL
  "3枚を均等幅で並べる"
  THREE_EQUAL
  "横長1枚（左）と縦長1枚（右）を並べる"
  WIDE_NARROW
  "縦長1枚（左）と横長1枚（右）を並べる"
  NARROW_WIDE
}

"グリッド型の行"
type GridRow {
  pattern: GridRowPattern!
  "左から順の写真"
  photos: [GridPhoto!]!
}

"グリッド型の写真の枠"
type GridPhoto {
  "枠に並べる写真。管理者により非公開にされた写真の枠は null（行の構成を保つため、枠だけを空けて表示する）"
  photo: Photo
}

"""
額縁型のレイアウト（1枚の額縁に複数の写真・メッセージを自由に配置した組写真）

位置・大きさ・太さ・文字サイズは、表示する画面の幅によらず同じ比率で描画できるよう、額縁に対する % で返す
"""
type FrameLayout {
  "額縁の横幅（mm）。縦横比の算出に使う"
  width: Float!
  "額縁の縦幅（mm）"
  height: Float!
  "額縁の背景（台紙）の色（#RRGGBB）"
  backgroundColor: String!
  "額縁の外枠の色（#RRGGBB）"
  borderColor: String!
  "額縁の外枠の太さ（額縁の横幅に対する %。0 の場合は外枠なし）"
  borderWidth: Float!
  "写真枠（写真を表示順に1枚ずつ割り当てたもの）"
  slots: [FrameSlot!]!
  "文面を入力したメッセージ枠"
  texts: [FrameText!]!
}

"額縁型の写真枠"
type FrameSlot {
  "左端の位置（額縁に対する %）"
  x: Float!
  "上端の位置（額縁に対する %）"
  y: Float!
  "横幅（額縁に対する %）"
  width: Float!
  "縦幅（額縁に対する %）"
  height: Float!
  "傾き（度。時計回りが正）"
  rotation: Float!
  "枠線の色（#RRGGBB）"
  borderColor: String!
  "枠線の太さ（額縁の横幅に対する %。0 の場合は枠線なし）"
  borderWidth: Float!
  "影を付けるかどうか"
  shadow: Boolean!
  "枠に当てはめる写真。管理者により非公開にされた写真の枠は null（組写真の構成を保つため、枠だけを空けて表示する）"
  photo: Photo
}

"額縁型のメッセージ枠のフォント"
enum FrameFontFamily {
  "ゴシック体"
  GOTHIC
  "明朝体"
  MINCHO
  "丸ゴシック体"
  MARU
  "手書き風"
  HANDWRITING
  "セリフ体（欧文）"
  SERIF
  "筆記体（欧文）"
  SCRIPT
}

"額縁型のメッセージ枠の揃え"
enum FrameTextAlign {
  LEFT
  CENTER
  RIGHT
}

"額縁型のメッセージ枠"
type FrameText {
  "左端の位置（額縁に対する %）"
  x: Float!
  "上端の位置（額縁に対する %）"
  y: Float!
  "横幅（額縁に対する %。文面はこの幅で折り返す）"
  width: Float!
  "傾き（度。時計回りが正）"
  rotation: Float!
  fontFamily: FrameFontFamily!
  "文字サイズ（額縁の横幅に対する %）"
  fontSize: Float!
  "文字の色（#RRGGBB）"
  color: String!
  align: FrameTextAlign!
  bold: Boolean!
  italic: Boolean!
  "文面"
  text: String!
}
